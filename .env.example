# ----------------------------------------------------------------------------
# Example secrets / configuration file.
# Copy this to ".env" and fill in values you actually have.
# NEVER commit your real .env file. NEVER paste real keys into chat or code.
# The system reads these via environment variables only.
# ----------------------------------------------------------------------------

# FRED (Federal Reserve Economic Data) - FREE API key for official US release DATES.
# Get one at: https://fredaccount.stlouisfed.org/apikeys
# Leaving this blank is fine: the system falls back to bundled sample events.
FRED_API_KEY=

# QuantConnect (OPTIONAL - only needed for LEAN cloud backtests / QC paper trading).
# Get these from your QuantConnect account (free tier). Leave blank to stay local.
QC_USER_ID=
QC_API_TOKEN=

# Live trading is DISABLED BY DEFAULT and intentionally has no credentials here.
# A future live broker connection would add its own keys - never to this example file.
# LIVE_TRADING_ENABLED must be the literal string "I_UNDERSTAND_THE_RISK" to even
# be considered, and even then the code path is stubbed and refuses to send orders.
LIVE_TRADING_ENABLED=false
